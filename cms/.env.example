# ---------- Server ----------
HOST=0.0.0.0
PORT=1337
# Public address of this CMS (used for PayHere's payment notification URL)
PUBLIC_URL=http://localhost:1337
# Public address of the storefront (used in emails and payment return links)
STOREFRONT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:1337
# Set to true when running behind Nginx/Caddy with HTTPS
# PRODUCTION (Railway): set IS_PROXIED=true. Railway serves HTTPS in front of Strapi, and without this
# Strapi treats requests as plain HTTP: secure admin login cookies can fail and visitor IPs are wrong.
# Also set PUBLIC_URL / STOREFRONT_URL / CORS_ORIGINS to your real https:// addresses.
IS_PROXIED=false

# ---------- Secrets: generate your own (run: node scripts/generate-secrets.js) ----------
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# ---------- PostgreSQL ----------
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=fragrancevault
DATABASE_USERNAME=fragrancevault
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# ---------- First run ----------
# Fills an empty database with the Fragrance Vault catalogue, payment methods, pages and homepage.
SEED_ON_EMPTY=true

# ---------- Order emails (leave SMTP_HOST empty to switch emails off) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=orders@fragrancevault.lk
SMTP_REPLY_TO=orders@fragrancevault.lk

# ---------- WooCommerce import (optional, for: npm run import:woo) ----------
WOO_URL=https://fragrancevault.lk
WC_KEY=
WC_SECRET=
