{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Customer orders. Change the status to process, ship, cancel or refund."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": {
      "type": "string",
      "unique": true
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": [
        "pending_payment",
        "on_hold",
        "processing",
        "shipped",
        "completed",
        "cancelled",
        "refunded",
        "failed"
      ],
      "default": "pending_payment",
      "required": true
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": [
        "unpaid",
        "paid",
        "partially_refunded",
        "refunded",
        "failed"
      ],
      "default": "unpaid"
    },
    "customerEmail": {
      "type": "email",
      "required": true
    },
    "customerPhone": {
      "type": "string"
    },
    "billing": {
      "type": "component",
      "repeatable": false,
      "component": "order.address"
    },
    "shipping": {
      "type": "component",
      "repeatable": false,
      "component": "order.address"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "order.line-item"
    },
    "subtotal": {
      "type": "decimal"
    },
    "discountTotal": {
      "type": "decimal",
      "default": 0
    },
    "shippingTotal": {
      "type": "decimal",
      "default": 0
    },
    "paymentFee": {
      "type": "decimal",
      "default": 0
    },
    "total": {
      "type": "decimal"
    },
    "currency": {
      "type": "string",
      "default": "LKR"
    },
    "couponCode": {
      "type": "string"
    },
    "paymentMethodName": {
      "type": "string"
    },
    "paymentMethodType": {
      "type": "string"
    },
    "shippingMethodName": {
      "type": "string"
    },
    "paymentReference": {
      "type": "string"
    },
    "transactionId": {
      "type": "string"
    },
    "paidAt": {
      "type": "datetime"
    },
    "courier": {
      "type": "string"
    },
    "trackingNumber": {
      "type": "string"
    },
    "trackingUrl": {
      "type": "string"
    },
    "customerNote": {
      "type": "text"
    },
    "adminNote": {
      "type": "text"
    },
    "stockReduced": {
      "type": "boolean",
      "default": false
    },
    "statusHistory": {
      "type": "component",
      "repeatable": true,
      "component": "order.status-entry"
    },
    "accessToken": {
      "type": "string",
      "private": true
    },
    "ipAddress": {
      "type": "string",
      "private": true
    }
  }
}