{
  "kind": "collectionType",
  "collectionName": "coupons",
  "info": {
    "singularName": "coupon",
    "pluralName": "coupons",
    "displayName": "Coupon",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "percent",
        "fixed_cart",
        "free_shipping"
      ],
      "default": "percent",
      "required": true
    },
    "amount": {
      "type": "decimal",
      "default": 0,
      "min": 0
    },
    "minimumSpend": {
      "type": "decimal",
      "min": 0
    },
    "maximumDiscount": {
      "type": "decimal",
      "min": 0
    },
    "usageLimit": {
      "type": "integer",
      "min": 0
    },
    "usageLimitPerCustomer": {
      "type": "integer",
      "min": 0
    },
    "usedCount": {
      "type": "integer",
      "default": 0
    },
    "startsAt": {
      "type": "datetime"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product"
    },
    "excludeSaleItems": {
      "type": "boolean",
      "default": false
    }
  }
}
