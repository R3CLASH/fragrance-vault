# Where the Strapi CMS runs (server-side only, never exposed to browsers)
STRAPI_URL=http://127.0.0.1:1337
# Optional read-only Strapi API token (Strapi → Settings → API Tokens). Leave empty to use public permissions.
STRAPI_API_TOKEN=
# Public address of this storefront (SEO, sitemap, payment return links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for instant updates: add a Strapi webhook to https://YOUR-SITE/api/revalidate?secret=THIS_VALUE
REVALIDATE_SECRET=change-me
